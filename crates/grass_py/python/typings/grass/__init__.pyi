"""Type stubs for the grass extension module (preview)."""

from typing import Any, Callable, Iterable, Literal, Mapping, Optional, Sequence, TypeVar, Union, overload

import numpy as np
import numpy.typing as npt

from . import plugins as plugins

T = TypeVar("T")
Key = Union[type, str]
Label = Union[str, Callable[..., Any]]
Array = npt.NDArray[np.float64]

class Sim:
    """Passed to a system parameter annotated `: grass.Sim` (or named `sim`)."""

    @property
    def step(self) -> int: ...
    time: float
    def stop(self) -> None: ...
    def tick(self, child: Key, n: int = 1) -> int: ...

class AppView:
    """A child App's resources, seen from a parent system."""

    @overload
    def __getitem__(self, key: type[T]) -> T: ...
    @overload
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: Key, value: Any) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

class RustPlugin: ...

class App:
    def __init__(self, config: Optional[str] = None, output_dir: Optional[str] = None) -> None: ...
    # resources
    def insert(self, value: object) -> None: ...
    @overload
    def __getitem__(self, key: type[T]) -> T: ...
    @overload
    def __getitem__(self, key: str) -> Any: ...
    @overload
    def __setitem__(self, key: type[T], value: T) -> None: ...
    @overload
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __contains__(self, key: Key) -> bool: ...
    def resources(self) -> list[str]: ...
    # schedule
    def add_phases(self, *names: str) -> None: ...
    def phases(self) -> list[str]: ...
    def add_system(
        self,
        func: Callable[..., Any],
        phase: str = "update",
        *,
        label: Optional[str] = None,
        before: Union[Label, Sequence[Label], None] = None,
        after: Union[Label, Sequence[Label], None] = None,
        run_if: Optional[Callable[..., bool]] = None,
    ) -> None: ...
    def add_setup_system(self, func: Callable[..., Any], phase: str = "setup", *, label: Optional[str] = None) -> None: ...
    def remove_system(self, label: Label) -> None: ...
    def schedule(self) -> list[tuple[int, str, str]]: ...
    # plugins
    def add_plugin(self, plugin: object) -> None: ...
    def checkpoint(self, *keys: Key) -> None: ...
    def config_reference(self) -> str: ...
    # child Apps
    def add_app(self, key: Key, child: "App") -> None: ...
    def tick(self, child: Key, n: int = 1, phase: str = "tick") -> None: ...
    # running
    def run(self, steps: Optional[int] = None) -> int: ...
    @property
    def steps(self) -> int: ...
    @property
    def done(self) -> bool: ...

# ---- toolbox ----------------------------------------------------------------

class Discretization:
    def __len__(self) -> int: ...
    def centroids(self) -> Array: ...
    def measures(self) -> Array: ...

class PointCloud(Discretization):
    def __init__(self, points: npt.ArrayLike) -> None: ...

class UniformGrid(Discretization):
    def __init__(
        self,
        lo: Sequence[float],
        hi: Sequence[float],
        n: Sequence[int],
        basis: Literal["constant", "trilinear"] = "constant",
        quadrature_order: int = 2,
    ) -> None: ...

class TriSurface(Discretization):
    def __init__(
        self,
        vertices: npt.ArrayLike,
        triangles: npt.ArrayLike,
        dofs: Literal["vertex", "face"] = "face",
        tolerance: float = 1e-9,
    ) -> None: ...

class Map:
    def __init__(
        self,
        src: Discretization,
        dst: Discretization,
        kind: Literal["intensive", "density", "extensive"] = "intensive",
        method: Literal["interpolate", "nearest"] = "interpolate",
        sampling: Optional[Literal["average", "centroid"]] = None,
    ) -> None: ...
    def __call__(self, values: npt.ArrayLike, fill: Optional[npt.ArrayLike] = None) -> Array: ...
    def report(self) -> dict[str, Any]: ...
    def matrix(self) -> Any: ...

class AdjointPair:
    def __init__(self, a: Discretization, b: Discretization) -> None: ...
    def sample(self, values: npt.ArrayLike) -> Array: ...
    def deposit(self, values: npt.ArrayLike) -> Array: ...

class OuterIteration:
    def __init__(
        self,
        x0: npt.ArrayLike,
        scheme: Literal["fixed", "aitken", "iqn-ils"] = "iqn-ils",
        omega0: float = 0.5,
        reuse: int = 0,
        filter: float = 1e-8,
        tol: float = 1e-6,
        max_iters: int = 50,
    ) -> None: ...
    @property
    def input(self) -> Array: ...
    def observe(self, output: npt.ArrayLike) -> Array: ...
    def begin_window(self) -> None: ...
    @property
    def done(self) -> bool: ...
    @property
    def converged(self) -> bool: ...
    @property
    def iters(self) -> int: ...
    @property
    def residual_norm(self) -> float: ...

class Waveform:
    def __init__(self, ncomp: int, interpolation: Literal["constant", "linear"] = "linear") -> None: ...
    def __getattr__(self, name: str) -> Any: ...

def read_checkpoint(path: str) -> Mapping[str, Any]: ...
