[
  {
    "plugin": "grass_io::clock::SimClockPlugin",
    "source": "crates/grass_io/src/clock.rs",
    "section": "clock",
    "fields": ["start_step", "start_time"],
    "schedule": "—",
    "extension": "advance_step; every_n_steps",
    "exchange": "—"
  },
  {
    "plugin": "grass_io::dump::DumpPlugin<grass_io::dump::RawFrameWriter>",
    "source": "crates/grass_io/src/dump.rs",
    "section": "dump",
    "fields": ["interval", "path_template"],
    "schedule": "DumpSchedule::Build (namespace 200); DumpSchedule::Write (namespace 200)",
    "extension": "DumpFormat::write_frame",
    "exchange": "—"
  },
  {
    "plugin": "grass_io::run::RunPlugin",
    "source": "crates/grass_io/src/run.rs",
    "section": "run",
    "fields": ["name", "steps", "dt", "skip", "save_at_end"],
    "schedule": "ScheduleSetupSet::PreSetup; ScheduleSetupSet::Setup; RunSchedule::Cycle (namespace 1000); update_cycle",
    "extension": "StageOverrides::section; UPDATE_CYCLE",
    "exchange": "—"
  },
  {
    "plugin": "grass_io::term_out::TermOutPlugin",
    "source": "crates/grass_io/src/term_out.rs",
    "section": "term_out",
    "fields": ["every", "columns", "width"],
    "schedule": "TermOutSchedule::Compute (namespace 100); TermOutSchedule::Print (namespace 100)",
    "extension": "TermOut::set(name, value)",
    "exchange": "—"
  },
  {
    "plugin": "oscillator_demo::OscillatorPlugin",
    "source": "crates/oscillator_demo/src/lib.rs",
    "section": "oscillator",
    "fields": ["x0", "v0", "peer_x0", "stiffness", "damping", "coupling_stiffness", "mass", "dt"],
    "schedule": "OscillatorSchedule::Integrate",
    "extension": "OscillatorPlugin; OscillatorSchedule; OscillatorPosition",
    "exchange": "PositionPort&lt;Source&gt; (local Port&lt;T&gt;)"
  }
]
